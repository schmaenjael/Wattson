### Discord ###
TOKEN="DISCORD_DEV_PORTAL_TOKEN"
CLIENT_ID=4242424242424242
APPLICATION_ID=4242424242424242
GUILD_ID=4242424242424242
ADMIN_USER_ID=4242424242424242
NODE_ENV="production"
# Pino log level: trace | debug | info | warn | error | fatal.
# Defaults to `info` in production/test and `trace` otherwise. Set to `debug` in production to surface
# expected-absence soft failures (member left, DMs closed, message deleted).
LOG_LEVEL=

### Postgres ###
POSTGRES_USER=superadmin
POSTGRES_PASSWORD=superadmin_password
POSTGRES_DB=wattsondb
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

### Bot DB credentials (role with least privilege on wattsondb) ###
BOT_USERNAME=wattson
BOT_PASSWORD=super_safe_bot_password

### Bot DB pool / retry tuning (optional — sensible defaults applied if unset) ###
# POOL_MAX=15
# DB_MAX_RETRIES=5
# DB_RETRY_DELAY_MS=5000

### Logto (SSO / Volt verification) — all required ###
LOGTO_ENDPOINT=https://logto.example.com
LOGTO_DEVICE_APP_ID=logto_device_app_id
LOGTO_M2M_APP_ID=logto_m2m_app_id
LOGTO_M2M_APP_SECRET=logto_m2m_app_secret
LOGTO_MANAGEMENT_API_RESOURCE=https://logto.example.com/api

### RAG DB credentials (zero visibility into bot tables; owns rag_data schema only) ###
RAG_DB_USER=ollama
RAG_DB_PASSWORD=super_safe_rag_password

### ML training DB credentials (read-only on the `ml` schema; zero visibility into public) ###
ML_DB_USER=ml_trainer
ML_DB_PASSWORD=super_safe_ml_password

### pgAdmin (dev only) ###
PGADMIN_DEFAULT_EMAIL=user@email
PGADMIN_DEFAULT_PASSWORD=safe_password

### Hate speech detection ###
# Local dev (bun run dev): use localhost since docker-compose exposes port 8000 to host.
# Production (wattson container): docker-compose sets this to http://hate-speech-detector:8000 automatically.
# Model weights download from Hugging Face on first container start and are cached in the
# hsd-model-cache Docker volume — no credentials needed, no re-download on restart.
HATE_SPEECH_DETECTOR_ENDPOINT=http://localhost:8000

### Ollama — harm detection ###
# Local dev (bun run dev): use localhost since docker-compose exposes port 11434 to host.
# Production (wattson container): docker-compose overrides this to http://ollama:11434 automatically.
# Harm detection model is configured in config/harm-detection.json5.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

### RAG service — knowledge-grounded /ask responses ###
# Local dev: use localhost since docker-compose exposes port 8080 to host.
# Production (wattson container): docker-compose sets this to http://rag:8080 automatically.
RAG_ENDPOINT=http://localhost:8080

### Health check ###
# Port the bot's internal HTTP health server listens on (serves GET /health and /healthz).
# Used by the wattson docker-compose healthcheck. Default: 30001.
HEALTHCHECK_PORT=30001

### Content filtering — file-based providers ###
# Comma-separated paths to Pi-hole-format domain blocklists (link filter feature).
# BLOCKLIST_PATHS=/data/config/blocklist.txt,/data/config/blocklist2.txt
# Path to the profanity list (bad-words filter feature). Format: "<pattern> <severity> [r]"
# PROFANITY_LIST_PATH=/data/config/bad-words.txt

### External posting stubs — BSKY (not wired yet) ###
# BSKY_SERVICE=https://bsky.social
# BSKY_IDENTIFIER=volteuropa.bsky.social
# BSKY_APP_PASSWORD=

