{
  "include": [
    "**/*.ts"
  ],
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": ".",
    "isolatedModules": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ESNext",
    "resolveJsonModule": true,
    "strict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "~/*": [
        "./src/*",
        "./scripts/*"
      ]
    },
    "noEmit": false,
    "skipLibCheck": true
  }
}