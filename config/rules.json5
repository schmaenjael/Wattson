{
  // Static server rules catalog. Environment-independent — loaded regardless of NODE_ENV.
  // Same data in every environment; per-environment values live in config.<NODE_ENV>.json5.
  rules: [
    {
      category: 'general',
      categoryIndex: 1,
      title: "Follow Discord's Terms of Service",
      content: "All members must comply with Discord's Terms of Service at all times. These are the platform-wide rules set by Discord that govern every account and every server. Serious or repeated violations may result in your account being reported directly to Discord.",
    },
    {
      category: 'general',
      categoryIndex: 2,
      title: "Follow Discord's Community Guidelines",
      content: "All members must comply with Discord's Community Guidelines. These guidelines address hate speech, harassment, self-harm content, and other harmful behaviour that Discord prohibits across the entire platform.",
    },
    {
      category: 'behaviour',
      categoryIndex: 1,
      title: 'No Discrimination or Extremist Ideologies',
      content: 'Discrimination of any kind is strictly prohibited. This includes — but is not limited to — racism, sexism, homophobia, and transphobia. Promoting or expressing support for extreme ideologies such as anti-democratic, violent, or fundamentalist belief systems is equally forbidden.',
    },
    {
      category: 'behaviour',
      categoryIndex: 2,
      title: 'No Harassment or Disrespectful Behaviour',
      content: 'Bullying, harassment, hacking, doxxing, and any other form of disrespectful behaviour are not permitted — whether in public channels or in direct messages. Do not share the contents of private DM conversations publicly. The only exception is forwarding evidence to a moderator for a rule-violation report.',
    },
    {
      category: 'behaviour',
      categoryIndex: 3,
      title: 'No Trolling',
      content: 'Trolling is not allowed. This includes posting messages purely to provoke a negative reaction from others, and making statements that are deliberately sarcastic or cynical in a way that derails conversation or upsets other members.',
      example: 'Posting an inflammatory political take you do not actually hold just to watch others argue is trolling.',
    },
    {
      category: 'behaviour',
      categoryIndex: 4,
      title: 'Mark Sarcasm and Jokes Clearly',
      content: 'When you are being sarcastic or joking, make it obvious to avoid misunderstandings. You can do this by adding a tone indicator such as /s (sarcasm), /j (joking), or a 🃏 emoji at the end of your message.',
      example: '"Oh sure, letting everyone vote is clearly a terrible idea /s"',
    },
    {
      category: 'behaviour',
      categoryIndex: 5,
      title: 'Argue in Good Faith',
      content: 'When taking part in discussions, engage honestly and fairly. This means actually reading what others have written, remaining genuinely open to different perspectives, and responding thoughtfully — not just trying to win an argument or score points.',
    },
    {
      category: 'behaviour',
      categoryIndex: 6,
      title: 'Do Not Block the Moderation Team',
      content: 'Blocking any member of the Volt Discord Team (moderators and admins) is not permitted. Moderators must be able to reach any member at any time for moderation purposes. Blocking them is treated as an attempt to evade moderation.',
    },
    {
      category: 'behaviour',
      categoryIndex: 7,
      title: 'No Raid Encouragement',
      content: 'Encouraging, organising, or participating in raids against other Discord servers is strictly forbidden. Raiding means coordinating a mass disruption of another community.',
    },
    {
      category: 'behaviour',
      categoryIndex: 8,
      title: 'No Persistent Disruptive Behaviour',
      content: 'Repeated patterns of disruptive behaviour are not allowed, even when individual incidents appear minor. This includes sustained negativity, persistent hostility towards other members, and attention-seeking behaviour that adds no value to the community.',
    },
    {
      category: 'messages',
      categoryIndex: 1,
      title: 'You Are Responsible for Your Account',
      content: 'You are responsible for all content posted from your account, regardless of who was at the keyboard. Claiming your account was compromised is not a valid excuse unless supported by credible evidence.',
    },
    {
      category: 'messages',
      categoryIndex: 2,
      title: 'No Spamming',
      content: 'Spamming is not allowed in any form. This includes sending the same message repeatedly, flooding channels with memes or GIFs, and posting walls of emoji. Keep your contributions meaningful and readable.',
    },
    {
      category: 'messages',
      categoryIndex: 3,
      title: 'No Misinformation',
      content: 'Spreading false or misleading information is not allowed. Back up factual claims with a credible and verifiable source. Unreliable sources are not accepted. Avoid making statements solely through screenshots or photos of news articles without proper context.',
    },
    {
      category: 'messages',
      categoryIndex: 4,
      title: 'Sensitive Topics Are Restricted',
      content: 'Discussion of sensitive topics — such as self-harm, mental health crises, or similar subjects — is only permitted in the dedicated venting channel. Before posting there, read the pinned message carefully and use appropriate trigger warnings.',
    },
    {
      category: 'messages',
      categoryIndex: 5,
      title: 'No Cross-Server Drama',
      content: 'Do not bring conflicts, feuds, or internal drama from other Discord servers into this community. Keep discussions focused on topics relevant to this server.',
    },
    {
      category: 'voice',
      categoryIndex: 1,
      title: 'No Disruptive Sounds',
      content: 'Do not disrupt voice channel conversations with background noise, loud sounds, soundboards, or microphone abuse. Make sure your audio setup is clean before joining a call.',
    },
    {
      category: 'voice',
      categoryIndex: 2,
      title: 'Share the Conversation',
      content: 'Do not monopolise a voice channel. Give other members a fair chance to speak. If a conversation is already in progress, wait for a natural pause before jumping in.',
    },
    {
      category: 'voice',
      categoryIndex: 3,
      title: 'No Recording Calls',
      content: 'Recording voice or video calls in this server is not permitted without the explicit consent of every participant in the call. This applies to any recording method, including screen capture software.',
    },
    {
      category: 'voice',
      categoryIndex: 4,
      title: 'No Illegal or Copyrighted Streaming',
      content: 'Do not stream or share illegal content in voice or video channels. This includes copyrighted films, music, TV shows, or any other trademarked material you do not have the rights to broadcast.',
    },
    {
      category: 'voice',
      categoryIndex: 5,
      title: 'No Channel-Hopping',
      content: 'Rapidly switching between voice channels in quick succession (channel-hopping) is not allowed. It is disruptive to ongoing conversations and generates unnecessary notifications for other members.',
    },
    {
      category: 'advertisements',
      categoryIndex: 1,
      title: 'No Unauthorised Advertising',
      content: 'Advertising or promoting anything — including your own social media accounts, external communities, products, or services — requires prior written permission from the Volt Discord Team. Unsolicited promotion will be removed.',
    },
    {
      category: 'advertisements',
      categoryIndex: 2,
      title: 'Volt-Related Promotion Is Welcome',
      content: "Sharing content related to Volt Europa — such as campaign events, official announcements, or Volt's official social media accounts — is permitted and encouraged without needing special approval.",
    },
    {
      category: 'channels',
      categoryIndex: 1,
      title: 'Stay On Topic',
      content: 'Each channel has a defined topic or purpose. Keep your messages relevant to the channel you are posting in. If you are unsure what a channel is for, check its description or pinned messages.',
    },
    {
      category: 'channels',
      categoryIndex: 2,
      title: 'English in International Channels',
      content: 'All conversations in international channels must be in English so that every member can follow and participate in the discussion.',
    },
    {
      category: 'channels',
      categoryIndex: 3,
      title: 'Local Languages in Country Channels',
      content: 'In country-specific or language-specific channels, members may communicate in the relevant local language in addition to English. Check the channel description to confirm which languages are appropriate for that channel.',
    },
    {
      category: 'prohibited-content',
      categoryIndex: 1,
      title: 'No NSFW Content',
      content: 'Not Safe For Work (NSFW) content is strictly forbidden everywhere on this server. This includes pornographic images, videos, written descriptions, and any other sexually explicit material.',
    },
    {
      category: 'prohibited-content',
      categoryIndex: 2,
      title: 'Extremist Symbols Only in Educational Contexts',
      content: 'Symbols associated with extreme ideologies — such as Nazi insignia or similar — are only permitted in educational contexts within the designated educational channels. Using such symbols casually, approvingly, or to intimidate others is forbidden.',
    },
    {
      category: 'prohibited-content',
      categoryIndex: 3,
      title: 'No Piracy',
      content: 'Sharing, linking to, or promoting pirated content or piracy tools is not condoned. This includes cracked software, illegally distributed media files, and instructions for circumventing content protection systems.',
    },
    {
      category: 'prohibited-content',
      categoryIndex: 4,
      title: 'Shitposting Only in #memes',
      content: 'Extensive shitposting, meme dumps, and off-topic humour are only permitted in the #memes channel. To gain access to that channel, assign yourself the "fun" role through the roles channel.',
    },
    {
      category: 'prohibited-content',
      categoryIndex: 5,
      title: 'No Graphic Content',
      content: 'Graphic content of any kind is forbidden on this server. This includes violent imagery, gore, disturbing photographs, or any visual content that could cause distress to other members.',
    },
    {
      category: 'user-profiles',
      categoryIndex: 1,
      title: 'Appropriate Profile Content',
      content: 'Your user profile — including your avatar, banner, display name, and status — must not contain controversial, offensive, or inappropriate imagery or text. Profiles that display extremist views, hate symbols, or targeted harassment will result in moderation action.',
    },
    {
      category: 'user-profiles',
      categoryIndex: 2,
      title: 'Readable Display Name Required',
      content: 'Your display name must be easily readable and pronounceable, and must begin with a standard Latin alphabet letter (A–Z or a–z). Names that are invisible, consist entirely of symbols, or start with non-Latin characters are not permitted.',
    },
    {
      category: 'user-profiles',
      categoryIndex: 3,
      title: 'No Impersonation',
      content: "You may not impersonate other people through your profile. This includes adopting another person's name, avatar, or any other identifying information to mislead other members about who you are.",
    },
    {
      category: 'user-profiles',
      categoryIndex: 4,
      title: 'One Account Per Person',
      content: 'Each person may only maintain one account in this server at any given time. If you are found to have alternative (alt) accounts present in the server, those accounts will have their access revoked and their IDs logged.',
    },
    {
      category: 'reporting',
      categoryIndex: 1,
      title: 'Report Rule Breaks via the Bot',
      content: 'If you witness another member breaking the rules, report it by replying to their message using the /report bot command. This creates a report that is immediately visible to the moderation team.',
    },
    {
      category: 'reporting',
      categoryIndex: 2,
      title: 'Ping Moderators for Urgent Issues',
      content: 'If a rule violation requires an immediate response — such as ongoing harassment, hate speech, or illegal content — ping the @Volt Discord Team role or reach out directly to an individual moderator who is currently online.',
    },
    {
      category: 'reporting',
      categoryIndex: 3,
      title: 'No Bot Feature Abuse',
      content: 'Abusing bot features or commands is not allowed. This includes spamming bot commands, attempting to exploit bot behaviour, or using bot features in ways they were not intended.',
    },
    {
      category: 'reporting',
      categoryIndex: 4,
      title: 'No Backseat Moderating',
      content: 'Do not act as a moderator if you are not one. You may politely remind another member of the rules, but issuing demands, ultimatums, or formal warnings on behalf of the moderation team is not permitted.',
    },
    {
      category: 'punishments',
      categoryIndex: 1,
      title: 'Standard Punishment Ladder',
      content: 'Breaking the rules may result in a warning, a mute, or a ban. All punishments are logged and visible in the moderation log channel. The severity of the punishment depends on the nature of the violation and your prior history.',
    },
    {
      category: 'punishments',
      categoryIndex: 2,
      title: 'Immediate Bans for Severe Violations',
      content: 'Moderators reserve the right to issue an immediate ban without prior warnings when the severity of a violation warrants it. This includes extreme harassment, hate speech, doxxing, or sharing illegal content.',
    },
    {
      category: 'punishments',
      categoryIndex: 3,
      title: 'Do Not Discuss Mod Actions Publicly',
      content: 'Discussing moderation decisions — such as warnings, mutes, or bans — in public server channels is not allowed. If you have questions or concerns about a moderation action, contact the team privately via ModMail or the feedback channel.',
    },
    {
      category: 'punishments',
      categoryIndex: 4,
      title: 'Game Violations Are Separate from Server Rules',
      content: 'Rule violations that occur during organised in-server games or events will not automatically result in Discord-level punishments. However, all server rules still apply during those events and in any related communications.',
    },
    {
      category: 'punishments',
      categoryIndex: 5,
      title: 'You Have the Right to Appeal',
      content: 'Every punishment notification includes a reference to the specific rule that was broken. Warnings and mutes can be appealed via ModMail. Bans can be appealed using the official appeal form. All appeals are reviewed by the moderation team.',
    },
  ],
}
