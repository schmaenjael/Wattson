{
  "name": "wattson",
  "version": "0.0.1",
  "description": " ",
  "keywords": [],
  "type": "module",
  "maintainers": [
    "schmaenjael"
  ],
  "license": "ISC",
  "scripts": {
    "start": "bun run ./build/src/index.js",
    "build": "tsc --build",
    "dev": "concurrently \"bun:dev:*\"",
    "dev:tsc": "bun --watch  \"./src/index.ts\" | pino-pretty",
    "dev:typesafe-i18n": "typesafe-i18n --watch",
    "script": "concurrently \"bun:script:*\"",
    "script:lint": "eslint --cache",
    "script:format": "prettier --write --log-level warn .",
    "script:register-commands": "bun --env-file=.env ./scripts/register-commands.ts | pino-pretty",
    "script:typesafe-i18n": "typesafe-i18n --no-watch"
  },
  "pre-commit": [
    "script:format",
    "script:lint"
  ],
  "dependencies": {
    "@discordjs/rest": "^2.4.3",
    "@types/pg": "^8.11.14",
    "discord.js": "^14.18.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "pg": "^8.15.6",
    "pino": "^9.6.0",
    "typesafe-i18n": "^5.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "chalk": "4.1.2",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "pino-pretty": "^13.0.0",
    "pre-commit": "^1.2.2",
    "prettier": "^3.5.1",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.28.0"
  },
  "engines": {
    "bun": ">=1.2.8"
  }
}
