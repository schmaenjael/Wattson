{
  "name": "wattson",
  "version": "0.0.1",
  "description": " ",
  "keywords": [],
  "type": "module",
  "maintainers": [
    "schmaenjael"
  ],
  "license": "ISC",
  "scripts": {
    "start": "bun run ./src/index.ts",
    "build": "tsc --build",
    "dev": "concurrently \"bun:dev:*\"",
    "dev:tsc": "bun --watch  \"./src/index.ts\" | pino-pretty",
    "dev:typesafe-i18n": "typesafe-i18n",
    "script": "concurrently \"bun:script:*\"",
    "script:lint": "eslint --cache",
    "script:format": "prettier --write --log-level warn .",
    "script:register-commands": "bun --env-file=.env ./scripts/register-commands.ts | pino-pretty",
    "script:validate-blocklists": "bun ./scripts/validate-blocklists.ts",
    "script:typesafe-i18n": "typesafe-i18n --no-watch",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun drizzle-kit migrate"
  },
  "pre-commit": [
    "script:format",
    "script:lint"
  ],
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@types/pg": "^8.20.0",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "croner": "^10.0.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "json5": "^2.2.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "typesafe-i18n": "^5.27.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "chalk": "5.6.2",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "pino-pretty": "^13.1.3",
    "pre-commit": "^2.0.0",
    "prettier": "^3.8.4",
    "tsc-watch": "^7.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "bun": ">=1.2.8"
  }
}
