    "chalk": "4.1.2",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "pre-commit": "^1.2.2",
    "prettier": "^3.5.1",
    "tsc-watch": "^6.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.28.0"
